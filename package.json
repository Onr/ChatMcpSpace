{
  "name": "chatmcpspace",
  "version": "1.0.0",
  "description": "AI Agent Messaging Platform - bidirectional communication between users and AI agents",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node scripts/run_all_migrations.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --runInBand --watch",
    "test:logged": "bash scripts/run_tests.sh",
    "test:receipts": "bash scripts/run_tests.sh tests/ui/message-receipts.test.js tests/ui/in-place-chat.test.js tests/ui/guest-workspace.test.js tests/ui/multi-chat-delete-optimistic.test.js tests/ui/mobile-scroll-preservation.test.js tests/utils/sharedRunner.test.js",
    "test:sharing": "bash scripts/verify-agent-sharing.sh",
    "test:e2e:create-agent": "node tests/e2e/create-agent-e2e.js",
    "test:e2e:rich-popup": "node tests/e2e/rich-popup-expand-screenshot.js",
    "test:e2e:mobile-visibility-audit": "node tests/e2e/mobile-dashboard-visibility-audit.js",
    "test:e2e:cos-install-wizard": "node tests/e2e/cos-install-wizard.js",
    "test:e2e:full-user-pipeline-cos-spawn": "node tests/e2e/full-user-pipeline-cos-spawn.js",
    "test:verify:cos": "bash tests/verify_chief_of_staff.sh",
    "test:perf:chat-switch": "node tests/perf/chat-switch-latency.js",
    "test:perf:chat-switch:compare": "node tests/perf/compare-chat-switch-reports.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o public/css/tailwind.css --minify"
  },
  "keywords": [
    "ai",
    "messaging",
    "agents",
    "mcp",
    "chat"
  ],
  "author": "onr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onr/ChatMcpSpace.git"
  },
  "bugs": {
    "url": "https://github.com/onr/ChatMcpSpace/issues"
  },
  "homepage": "https://github.com/onr/ChatMcpSpace#readme",
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "bcrypt": "^6.0.0",
    "blessed": "^0.1.81",
    "compression": "^1.8.1",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.22.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.17.3",
    "helmet": "^7.2.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12"
  },
  "overrides": {
    "qs": "6.16.0",
    "immutable": "4.3.9",
    "@tootallnate/once": "3.0.1",
    "ws": "8.21.0",
    "@grpc/grpc-js": "1.14.5",
    "protobufjs": "7.6.6",
    "brace-expansion@2.x": "2.1.7",
    "form-data": "4.0.6",
    "js-yaml": "4.3.2",
    "browserslist": "4.28.9",
    "baseline-browser-mapping": "2.11.22",
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.58.2",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pg-mem": "^2.8.3",
    "supertest": "^7.1.3",
    "tailwindcss": "3.4.19",
    "uuid": "^11.1.1"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
