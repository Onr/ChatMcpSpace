                                                    class="w-full bg-slate-900/50 border border-slate-600 text-white text-xs rounded-lg px-2 py-1.5">
                                                    <option value="default">Default</option>
                                                    <option value="acceptEdits">Accept Edits</option>
                                                    <option value="plan">Plan Only</option>
                                                    <option value="bypassPermissions" selected>Bypass Permissions
                                                    </option>
                                                </select>
