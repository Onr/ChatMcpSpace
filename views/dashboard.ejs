                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <!-- Message Input -->
                <div id="messageInputArea"
                    class="hidden absolute bottom-0 left-0 right-0 z-20 border-t border-white/10 px-5 py-4 bg-slate-900/40 backdrop-blur-xl shadow-[0_-10px_40px_-10px_rgba(0,0,0,0.5)]">
                    <div id="mobileAgentStatusStrip" class="mobile-agent-status-strip hidden" aria-live="polite"
