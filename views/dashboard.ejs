                                                    class="flex items-center gap-2 text-[10px] text-slate-400 cursor-pointer">
                                                    <input type="checkbox" id="configCopilotYolo"
                                                        class="rounded bg-slate-900 border-slate-600 text-emerald-500 focus:ring-emerald-500/50">
                                                    YOLO Mode (--allow-all / --yolo)
