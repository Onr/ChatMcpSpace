                                                        <span class="sr-only">Enable inter-agent communication</span>
                                                        <span
                                                            class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0"></span>
                                                    </button>
                                                </div>

                                                <!-- Status Display -->
                                                <div id="interAgentStatus"
                                                    class="flex items-start gap-2 p-2 rounded-lg bg-slate-800/50 border border-slate-700/50">
                                                    <div class="flex-shrink-0 mt-0.5">
                                                        <div id="interAgentStatusIcon"
                                                            class="w-2 h-2 rounded-full bg-slate-500"></div>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p id="interAgentStatusText" class="text-[10px] text-slate-400">
                                                            Agent-to-agent communication disabled</p>
                                                        <p id="interAgentGroupInfo"
                                                            class="text-[9px] text-slate-500 mt-0.5 hidden"></p>
                                                    </div>
                                                </div>

                                                <!-- Mode Selection (hidden by default, shown when enabled) -->
                                                <div id="interAgentModeSelect" class="hidden">
                                                    <label class="text-[9px] text-slate-500 block mb-1">Communication
                                                        Mode</label>
                                                    <select id="configInterAgentMode"
                                                        class="w-full bg-slate-900/50 border border-slate-600 text-white text-xs rounded-lg px-2 py-1.5">
                                                        <option value="listen_all">All Agents</option>
                                                        <option value="groups">Groups Only</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <button id="saveConfigBtn" type="button"
                                                class="w-full px-3 py-2 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-xs font-semibold hover:bg-emerald-500/30 transition">
                                                Save Config
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <!-- Stop Agent Button -->
                                <button id="agentStopBtn" type="button"
                                    class="px-3 py-2 rounded-full bg-red-500/20 border border-red-500/40 text-red-400 text-xs font-semibold tracking-wide hover:bg-red-500/30 transition disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5"
                                    disabled title="Stop Agent">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                                        <rect x="6" y="6" width="12" height="12" rx="2" />
                                    </svg>
                                    <span class="hidden sm:inline">Stop</span>
                                </button>
                                <button id="userMessageSend" type="submit"
                                    class="px-4 py-2 rounded-full bg-emerald-400 text-slate-950 font-semibold text-xs tracking-wide uppercase shadow-lg shadow-emerald-500/30 hover:bg-emerald-300 transition disabled:opacity-60 disabled:cursor-not-allowed disabled:shadow-none"
                                    disabled aria-label="Send message" title="Hold to schedule or manage scheduled messages">
                                    <svg class="send-spaceship-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path class="send-spaceship-flame" d="M4.2 16.2 1.7 21l4.8-2.5" />
                                        <path d="M6.5 17.5 10.3 21l1.7-5.1" />
                                        <path d="M6.5 17.5 3 13.7l5.1-1.7" />
                                        <path d="M8.1 12c3.5-5.2 7.9-8.1 13.4-9.2-.9 5.5-4 9.9-9.2 13.4L8.1 12Z" />
                                        <circle cx="15.7" cy="8.3" r="1.6" />
                                    </svg>
                                    <span class="send-label">Send</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </aside>

            <button id="sideChatAddBtn" type="button" class="side-chat-add-btn hidden"
                aria-label="Add side chat" title="Add side chat">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M12 5v14M5 12h14" />
                </svg>
            </button>

            <div id="sideChatPicker" class="side-chat-picker hidden" role="dialog" aria-modal="false"
                aria-labelledby="sideChatPickerTitle">
                <div class="side-chat-picker__header">
                    <div>
                        <h3 id="sideChatPickerTitle">Open Side Chat</h3>
                        <p>Choose an agent to pin beside this chat.</p>
                    </div>
                    <button id="sideChatPickerCloseBtn" type="button" class="side-chat-picker__close"
                        aria-label="Close side chat picker">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <input id="sideChatPickerSearch" class="side-chat-picker__search" type="search"
                    placeholder="Search chats" autocomplete="off" />
                <div id="sideChatPickerList" class="side-chat-picker__list" role="listbox"></div>
            </div>

            <!-- Side-panel tiles are injected here by multi-chat.js -->
        </div>

    </div>

    <!-- Feedback Widget (Moved to global layout) -->

</div>

<% if (process.env.FEATURE_SHARED_CONVERSATIONS === 'true' && inPlaceSharingEnabled) { %>
<aside id="sharingAccessNotice" hidden role="status" aria-live="polite" class="fixed bottom-4 left-4 right-4 z-[180] mx-auto max-w-lg rounded-xl border border-amber-500/40 bg-slate-900 p-4 shadow-xl">
    <p id="sharingAccessNoticeText" class="text-sm text-amber-100"></p>
    <div class="mt-3 flex flex-wrap gap-2">
        <button id="sharingAccessUnlock" type="button" class="min-h-11 rounded-lg bg-emerald-600 px-4 font-semibold text-white">Unlock locally</button>
        <button id="sharingAccessRetry" type="button" class="min-h-11 rounded-lg border border-slate-600 px-4 text-slate-200">Retry access setup</button>
    </div>
</aside>
<div id="shareExistingChatDialog" class="hidden fixed inset-0 z-[240] items-center justify-center bg-black/70 p-4" role="dialog" aria-modal="true" aria-labelledby="shareExistingChatTitle">
    <section class="in-place-share-panel w-full max-w-lg rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl">
        <header class="flex items-center justify-between border-b border-slate-700 px-5 py-4">
            <div class="in-place-share-heading">
                <span class="in-place-share-mark" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/></svg></span>
                <div><h2 id="shareExistingChatTitle" class="text-lg font-semibold text-white">Share this conversation</h2><p>Invite people into this agent chat.</p></div>
            </div>
            <button id="shareExistingChatClose" class="min-h-11 min-w-11 rounded-lg text-slate-300 hover:bg-slate-800" aria-label="Close sharing panel">×</button>
        </header>
        <div class="in-place-share-body space-y-4 p-5">
            <div id="agentSharingSwitchRow" class="agent-sharing-switch-row" hidden>
                <div><strong>Agent sharing</strong><p id="agentSharingSwitchHint">Off keeps this conversation private.</p></div>
                <button id="agentSharingSwitch" type="button" role="switch" aria-checked="false" aria-label="Agent sharing" aria-describedby="agentSharingSwitchHint" disabled><span data-sharing-switch-label>Off</span><span class="agent-sharing-switch-track" aria-hidden="true"><span></span></span></button>
            </div>
            <p id="shareExistingChatStatus" class="text-sm text-slate-300" aria-live="polite">Review the history that will move into the shared conversation.</p>
            <button id="shareExistingChatRetry" type="button" hidden class="min-h-11 rounded-lg border border-emerald-500/40 px-4 text-sm font-semibold text-emerald-200 hover:bg-emerald-500/10">Try again</button>
            <p id="shareConversationScope" class="text-xs leading-relaxed text-slate-400">When sharing is on, invited people can read the saved conversation history and files and send messages to this agent. Your account encryption password stays private; invitees use their own account.</p>
            <div id="shareExistingChatPreview" class="rounded-xl border border-slate-700 bg-slate-950/60 p-4 text-sm text-slate-300"></div>
            <div id="shareExistingChatInvites" hidden class="space-y-3 rounded-xl border border-slate-700 bg-slate-950/40 p-4">
                <label for="shareInviteEmail" class="block text-xs font-semibold uppercase tracking-wide text-slate-400">Invite by account email</label>
                <div class="flex gap-2"><input id="shareInviteEmail" type="email" autocomplete="email" placeholder="person@example.com" class="min-w-0 flex-1 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"><button id="shareInviteSubmit" type="button" class="min-h-11 px-4 rounded-lg bg-emerald-600 font-semibold text-white">Invite</button></div>
                <p id="shareInviteDelivery" class="text-xs text-slate-400" aria-live="polite">The invitee can join from their dashboard inbox or a signup link.</p>
                <div id="shareInviteSignupResult" hidden class="space-y-2 rounded-lg border border-cyan-500/20 p-3">
                    <p class="text-xs text-slate-300">For someone who has not registered, send them this link. They must verify the invited email address.</p>
                    <div class="flex gap-2"><input id="shareInviteSignupLink" readonly class="min-w-0 flex-1 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"><button id="shareInviteSignupCopy" type="button" class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Copy signup link</button><button id="shareInviteSignupSend" type="button" class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Send link</button></div>
                </div>
                <div id="shareInviteList" class="space-y-2 text-xs text-slate-300" aria-label="People with access"></div>
                <details id="shareInvitationHistory" hidden class="mt-3 rounded-lg border border-slate-700 p-3"><summary class="cursor-pointer text-xs text-slate-400">Past invitations</summary><div id="shareHistoricalInvitationList" class="mt-2 space-y-2 text-xs text-slate-400"></div></details>
            </div>
            <% if (process.env.FEATURE_GUEST_SHARING === 'true') { %>
            <div id="shareGuestControls" hidden class="space-y-2 rounded-xl border border-slate-700 bg-slate-950/40 p-4">
                <div id="shareLinkQuick" class="share-link-quick">
                    <div><strong>Share link</strong><p id="shareLinkQuickHint">Anyone with the link can ask to join this conversation as a guest.</p></div>
                    <div class="share-link-quick__actions"><button id="shareLinkCopy" type="button" class="min-h-11 px-4 rounded-lg bg-emerald-600 font-semibold text-white disabled:opacity-50">Copy link</button><button id="shareLinkSend" type="button" class="min-h-11 px-4 rounded-lg border border-emerald-500/50 font-semibold text-emerald-200 hover:bg-emerald-500/10 disabled:opacity-50">Send link</button></div>
                </div>
                <fieldset id="shareGuestLimits" class="space-y-2 rounded-lg border border-slate-700 p-3">
                    <legend class="px-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Guest limits</legend>
                    <p class="text-xs text-slate-400">People without an account can join only after you press Approve.</p>
                    <label for="shareGuestAccessMode" class="block text-xs font-semibold tracking-wide text-slate-400">Link type<select id="shareGuestAccessMode" aria-describedby="shareGuestAccessModeHint" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"><option value="join">Join link: they join, then wait for your approval</option><option value="request">Request link: they ask you first</option></select></label>
                    <p id="shareGuestAccessModeHint" class="text-xs text-slate-400">With either type, people with an account can also ask with their account. Requests appear under People with access.</p>
                    <label for="shareGuestExpiryPreset" class="block text-xs font-semibold tracking-wide text-slate-400">Access lasts<select id="shareGuestExpiryPreset" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"><option value="">No time limit</option><option value="3600000">1 hour</option><option value="86400000">1 day</option><option value="604800000">7 days</option><option value="2592000000">30 days</option><option value="custom">Until a date…</option></select></label>
                    <label id="shareGuestExpiresAtLabel" hidden for="shareGuestExpiresAt" class="block text-xs font-semibold tracking-wide text-slate-400">Link expires<input id="shareGuestExpiresAt" type="datetime-local" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"></label>
                    <label for="shareGuestMaxMessages" class="block text-xs font-semibold tracking-wide text-slate-400">Messages per guest<input id="shareGuestMaxMessages" type="number" min="1" max="100000" step="1" inputmode="numeric" placeholder="No limit" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"></label>
                    <button id="shareGuestLimitsSave" type="button" hidden class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Save limits</button>
                    <p id="shareGuestLimitsStatus" class="text-xs text-slate-400" aria-live="polite"></p>
                </fieldset>
                <label for="shareGuestPasscode" class="block text-xs font-semibold uppercase tracking-wide text-slate-400">Optional guest access code</label>
                <div class="flex gap-2"><input id="shareGuestPasscode" type="password" autocomplete="new-password" minlength="12" maxlength="72" placeholder="12–72 UTF-8 bytes" aria-describedby="shareGuestCodeHint" class="min-w-0 flex-1 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"><button id="shareGuestPasscodeGenerate" type="button" class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Generate</button><button id="shareGuestPasscodeReveal" type="button" class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Show</button><button id="shareGuestPasscodeCopy" type="button" class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Copy</button></div>
                <p id="shareGuestCodeHint" class="text-xs text-slate-400">Guests use this code and their display name. They never need your account encryption password. Send the code separately from the private link.</p>
                <label class="flex items-start gap-2 text-xs text-slate-400"><input id="shareGuestClearPasscode" type="checkbox" class="mt-0.5">Remove the current guest access code when replacing the link</label>
                <button id="shareGuestLinkCreate" type="button" disabled class="min-h-11 px-4 rounded-lg border border-cyan-500/50 text-cyan-200 hover:bg-cyan-500/10">Create guest link</button>
                <p id="shareGuestLinkStatus" class="text-xs text-slate-400" aria-live="polite">Guest access will use this same conversation.</p>
                <div id="shareGuestLinkResult" hidden class="flex gap-2"><input id="shareGuestLinkValue" readonly class="min-w-0 flex-1 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white"><button id="shareGuestLinkCopy" type="button" class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Copy</button><button id="shareGuestLinkSend" type="button" class="min-h-11 px-3 rounded-lg bg-slate-700 text-white">Send</button></div>
                <button id="shareGuestLinkDisable" type="button" hidden class="min-h-11 px-3 rounded-lg border border-rose-500/30 text-rose-200">Disable guest access</button>
            </div>
            <% } %>
        </div>
        <footer class="in-place-share-actions">
            <button id="shareExistingChatCancel" class="min-h-11 px-4 rounded-lg text-slate-300 hover:bg-slate-800">Cancel</button>
            <button id="shareHistoryAbort" type="button" hidden class="min-h-11 px-3 rounded-lg text-rose-200 hover:bg-rose-950">Discard preparation</button>
            <button id="shareExistingChatPrepare" disabled class="min-h-11 px-4 rounded-lg bg-emerald-600 font-semibold text-white disabled:opacity-50">Share this conversation</button>
        </footer>
    </section>
</div>
<% } %>


<!-- Image Lightbox Modal -->
<div id="imageLightbox" class="image-lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <div class="image-lightbox-content">
        <button type="button" class="image-lightbox-close" id="lightboxCloseBtn" aria-label="Close image viewer">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <img id="lightboxImage" class="image-lightbox-image" src="" alt="Full size image" />
        <div class="image-lightbox-info">
            <span id="lightboxFilename" class="image-lightbox-filename"></span>
            <a id="lightboxDownload" class="image-lightbox-download" href="#" download>
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
