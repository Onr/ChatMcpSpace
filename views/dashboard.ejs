</div>

<!-- Run Command Modal -->
<div id="runCommandModal"
    class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/65 backdrop-blur-sm p-4">
    <div class="w-full max-w-3xl overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl">
        <div class="flex items-start justify-between gap-4 border-b border-slate-700/60 bg-slate-800/80 px-6 py-4">
            <div>
                <h3 id="runCommandModalTitle" class="text-lg font-semibold text-white">Agent command</h3>
                <p id="runCommandModalSubtitle" class="mt-1 text-xs text-slate-400">Triggered from this message</p>
            </div>
            <button id="runCommandModalCloseBtn" type="button"
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-600 text-slate-300 transition hover:border-slate-400 hover:text-white"
                aria-label="Close command preview">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="px-6 py-5">
            <p class="mb-3 text-xs uppercase tracking-[0.22em] text-cyan-300/80">Exact command before execution</p>
            <pre id="runCommandModalBody"
                class="max-h-[60vh] overflow-auto rounded-2xl border border-slate-700 bg-slate-950/90 p-4 text-xs leading-6 text-slate-100 whitespace-pre-wrap break-all"></pre>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-slate-700/60 bg-slate-800/60 px-6 py-4">
            <button id="runCommandModalDismissBtn" type="button"
                class="rounded-full border border-slate-600 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-slate-400 hover:text-white">
                Close
            </button>
            <button id="runCommandModalCopyBtn" type="button"
                class="rounded-full bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300">
                Copy command
            </button>
        </div>
    </div>
</div>

<!-- Decryption Password Modal (for Google OAuth users) -->
<div id="decryptionPasswordModal"
    class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-700/50 bg-gradient-to-r from-emerald-500/10 to-cyan-500/10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">Decrypt Agent Messages</h3>
                    <p class="text-xs text-slate-400">Enter your agent encryption password</p>
                </div>
            </div>
        </div>

        <!-- Modal Body -->
        <div class="px-6 py-5">
            <div class="mb-4 p-3 rounded-lg bg-sky-500/10 border border-sky-500/20">
                <p class="text-xs text-sky-300 leading-relaxed">
                    <span class="font-semibold">🔐 End-to-end encrypted:</span> Enter the same password you used
                    when
                    creating your agent via CLI. This password is stored <strong>locally in your browser
                        only</strong>
                    and is never sent to our servers.
                </p>
            </div>

            <form id="decryptionPasswordForm" class="space-y-4">
                <div>
                    <label for="decryptionPasswordInput"
                        class="block text-sm font-medium text-slate-300 mb-2">Decryption Password</label>
                    <input type="password" id="decryptionPasswordInput"
                        class="w-full bg-slate-900/50 border border-slate-600 focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400/50 text-white rounded-lg px-4 py-3 text-sm placeholder:text-slate-500 transition"
                        placeholder="Enter the password you used in CLI" autocomplete="off" />
                </div>

                <div id="decryptionPasswordError" class="hidden p-3 rounded-lg bg-red-500/10 border border-red-500/20">
                    <p class="text-xs text-red-300">Failed to derive encryption key. Please check your password.
                    </p>
                </div>
            </form>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 border-t border-slate-700/50 bg-slate-800/50 flex justify-between items-center gap-3">
            <button id="decryptionSkipBtn" type="button"
                class="px-4 py-2 text-sm text-slate-400 hover:text-slate-200 transition">
                Skip for now
            </button>
            <button id="decryptionSubmitBtn" type="button"
                class="px-6 py-2.5 rounded-full bg-emerald-500 text-slate-950 font-semibold text-sm tracking-wide shadow-lg shadow-emerald-500/30 hover:bg-emerald-400 transition disabled:opacity-50 disabled:cursor-not-allowed">
                Unlock Messages
            </button>
        </div>
    </div>
</div>

<!-- Archive Confirmation Modal -->
<div id="archiveConfirmationModal"
    class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-700/50 bg-gradient-to-r from-amber-500/10 to-orange-500/10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-amber-500/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">Archive Agent</h3>
                    <p class="text-xs text-slate-400">Move agent to archive</p>
                </div>
            </div>
        </div>

        <!-- Modal Body -->
        <div class="px-6 py-5">
            <div class="mb-4 p-3 rounded-lg bg-amber-500/10 border border-amber-500/20">
                <p class="text-xs text-amber-300 leading-relaxed">
                    <span class="font-semibold" id="archiveModalAgentNameLabel">Archive this agent?</span>
                    <br />
                    The agent and all its messages will be removed from your active dashboard. You can restore it later
                    from the Archive page.
                </p>
            </div>

            <form id="archiveConfirmationForm" class="space-y-4">
                <div>
                    <label for="archiveReasonInput" class="block text-sm font-medium text-slate-300 mb-2">Reason
