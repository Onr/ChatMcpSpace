                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </div>
                    <div id="mainInteractiveContent" class="hidden max-h-[40vh] overflow-y-auto px-4 pb-4">
