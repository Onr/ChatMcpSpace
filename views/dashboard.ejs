                    <button id="ownerHistoryRetry" type="button" hidden class="ml-2 min-h-11 rounded-lg px-3 font-semibold text-emerald-300">Retry private history</button>
                </div>
                <% if (process.env.FEATURE_SHARED_CONVERSATIONS === 'true' && inPlaceSharingEnabled) { %>
                <aside id="sharingExecutionNotice" hidden role="status" aria-live="polite"
                    class="mx-4 my-2 shrink-0 rounded-lg border border-amber-500/30 bg-slate-900 p-3">
                    <p class="text-sm text-amber-100">An earlier request was interrupted. Choose how to continue with your queued messages.</p>
                    <p class="mt-1 text-xs text-slate-400">Retry may repeat actions the agent already completed.</p>
