                                                    class="flex items-center gap-2 text-[10px] text-slate-400 cursor-pointer">
                                                    <input type="checkbox" id="configClaudeSkip" checked
                                                        class="rounded bg-slate-900 border-slate-600 text-emerald-500 focus:ring-emerald-500/50">
                                                    Skip All Permissions (Dangerous)
                                                </label>
                                                <label class="text-[10px] text-slate-400 uppercase tracking-wider block">Thinking effort</label>
                                                <select id="configClaudeThinkingEffort"
                                                    class="w-full bg-slate-900/50 border border-slate-600 text-white text-xs rounded-lg px-2 py-1.5">
                                                    <option value="medium">Medium</option>
                                                    <option value="low">Low</option>
                                                    <option value="high">High</option>
                                                    <option value="xhigh">Extra High</option>
                                                    <option value="max">Maximum</option>
                                                </select>
