                                                <label
                                                    class="text-[10px] text-slate-400 uppercase tracking-wider block mb-1">Provider</label>
                                                <select id="configProvider"
                                                    class="w-full bg-slate-900/50 border border-slate-600 text-white text-xs rounded-lg px-2 py-1.5">
                                                    <option value="codex">Codex (Default)</option>
                                                    <option value="claude">Claude</option>
                                                    <option value="gemini">Gemini</option>
                                                    <option value="copilot">Copilot (GitHub)</option>
                                                    <option value="antigravity">Antigravity</option>
                                                    <option value="pi">Pi</option>
                                                    <option value="ollama">Ollama</option>
                                                    <option value="openrouter">OpenRouter</option>
                                                </select>
                                            </div>

                                            <!-- Model (populated dynamically) -->
                                            <div>
                                                <label
                                                    class="text-[10px] text-slate-400 uppercase tracking-wider block mb-1">Model</label>
                                                <select id="configModel"
                                                    class="w-full bg-slate-900/50 border border-slate-600 text-white text-xs rounded-lg px-2 py-1.5">
                                                    <option value="default">Default</option>
                                                </select>
                                            </div>

                                            <!-- Codex-specific options -->
                                            <div id="codexOptions" class="space-y-2">
