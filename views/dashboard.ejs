                            <span id="mobileConfigModel">-</span>
                        </span>
                        <span class="mobile-agent-status-strip__item" title="Mode">
                            <span class="mobile-agent-status-strip__label">Md:</span>
                            <span id="mobileConfigMode">-</span>
                        </span>
                        <span class="mobile-agent-status-strip__item" title="Access">
