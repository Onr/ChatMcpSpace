<% const inPlaceSharingEnabled = typeof featureInPlaceAgentSharing === 'boolean' ? featureInPlaceAgentSharing : process.env.FEATURE_IN_PLACE_AGENT_SHARING === 'true'; %>
<link rel="stylesheet" href="<%= assetUrl('/css/agent-actions.css') %>">
<link rel="stylesheet" href="<%= assetUrl('/css/agent-brief.css') %>">
<%- include('partials/agent-actions', { inPlaceSharingEnabled }) %>
<% if (process.env.FEATURE_SHARED_CONVERSATIONS === 'true' && inPlaceSharingEnabled) { %>
<link rel="stylesheet" href="<%= assetUrl('/css/in-place-sharing.css') %>">
<% } %>

<!-- Council Chamber Interface -->
<div id="dashboardRoot" data-encryption-salt="<%= encryptionSalt || '' %>"
    data-user-id="<%= typeof user !== 'undefined' ? (user?.userId || user?.user_id || '') : '' %>"
    data-display-name="<%= typeof user !== 'undefined' ? (user?.displayName || user?.name || user?.email || 'You') : 'You' %>"
    data-is-google-auth="<%= isGoogleAuth ? 'true' : 'false' %>"
    class="w-full px-4 sm:px-6 lg:px-8 space-y-6 lg:h-[calc(100vh-8rem)] flex flex-col">

    <!-- Council Chamber - Main View -->
    <div class="dashboard-main-grid grid gap-5 flex-1 lg:overflow-hidden min-h-0">

        <!-- Council Chamber Circle -->
        <div class="council-chamber glass-panel flex flex-col h-full relative overflow-hidden">
            <!-- Council Minimized View (desktop only) -->
            <div id="councilMinimizedView" class="hidden flex-col items-center py-6 gap-8 h-full bg-slate-900/40">
                <button id="maximizeCouncilBtn"
                    class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 hover:bg-emerald-500/30 transition shadow-lg shadow-emerald-900/20"
                    title="Expand Council" aria-label="Expand Council">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                    </svg>
                </button>

                <div class="flex flex-col gap-6 mt-4">
                    <div class="flex flex-col items-center gap-1 group relative">
                        <div
                            class="w-10 h-10 rounded-full bg-red-500/20 border border-red-500/40 flex items-center justify-center text-red-400">
                            <span class="font-bold text-sm" id="minimizedStatsUrgent">
                                <%= agents ? agents.filter(a=> a.lastMessagePriority === 'high').length : 0 %>
                            </span>
                        </div>
                        <span class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Urgent</span>
                        <div
                            class="absolute left-full ml-2 px-2 py-1 bg-slate-800 text-white text-[10px] rounded opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity whitespace-nowrap z-50 shadow-xl border border-slate-700">
                            Urgent Agents</div>
                    </div>

                    <div class="flex flex-col items-center gap-1 group relative">
                        <div
                            class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400">
                            <span class="font-bold text-sm" id="minimizedStatsAttention">
                                <%= agents ? agents.filter(a=> a.lastMessagePriority === 'normal').length : 0 %>
                            </span>
                        </div>
                        <span class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Needs</span>
                        <div
                            class="absolute left-full ml-2 px-2 py-1 bg-slate-800 text-white text-[10px] rounded opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity whitespace-nowrap z-50 shadow-xl border border-slate-700">
                            Needs Attention</div>
                    </div>

                    <div class="flex flex-col items-center gap-1 group relative">
                        <div
                            class="w-10 h-10 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
                            <span class="font-bold text-sm" id="minimizedStatsTotal">
                                <%= agents ? agents.length : 0 %>
                            </span>
                        </div>
                        <span class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Total</span>
                        <div
                            class="absolute left-full ml-2 px-2 py-1 bg-slate-800 text-white text-[10px] rounded opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity whitespace-nowrap z-50 shadow-xl border border-slate-700">
                            Total Agents</div>
                    </div>
                </div>
            </div>

            <div id="mobileHeader" class="px-5 pt-3 pb-2 border-b border-white/5 z-10 transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <!-- Header Nav Left -->
                        <button id="headerNavLeft"
                            class="mini-nav-btn mobile-header-nav-btn lg:hidden w-8 h-8 rounded-full bg-slate-800/80 border border-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition"
                            aria-label="Previous Agent">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>

                        <h2 class="council-header-title text-xl font-semibold text-white mt-1 whitespace-nowrap">Council Chamber</h2>

                        <button id="minimizeCouncilBtn"
                            class="hidden lg:flex w-8 h-8 rounded-full bg-slate-800/80 border border-slate-700 items-center justify-center text-slate-400 hover:text-white transition ml-2"
                            title="Minimize Council" aria-label="Minimize Council">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                            </svg>
                        </button>

                        <!-- Header Nav Right -->
                        <button id="headerNavRight"
                            class="mini-nav-btn mobile-header-nav-btn lg:hidden w-8 h-8 rounded-full bg-slate-800/80 border border-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition"
                            aria-label="Next Agent">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5l7 7-7 7" />
                            </svg>
                        </button>

                        <button id="collapseMobileListBtn"
                            class="lg:hidden w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-slate-400 hover:text-emerald-400 hover:bg-white/20 transition ml-1"
                            title="Expand List" aria-label="Expand agent list" type="button" aria-controls="agentListPanel" aria-expanded="false">
                            <%- include('partials/agent-list-icon') %>
                        </button>
                    </div>
                    <button id="mobileCouncilActionsToggle" type="button"
                        class="mobile-council-actions-toggle hidden w-8 h-8 rounded-full bg-slate-800/80 border border-slate-700 items-center justify-center text-slate-300 hover:text-white transition"
                        aria-label="Open council actions" aria-expanded="false" aria-controls="councilHeaderActions">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
                        </svg>
                    </button>
                    <div id="councilHeaderActions" class="council-header-actions flex gap-2">
                        <button id="mobileGroupManagementBtn" type="button"
                            class="mobile-group-management-action hidden px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-violet-300 hover:text-violet-200 hover:border-violet-400/50 hover:bg-violet-400/10 transition text-xs items-center gap-2"
                            title="Group Management">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span>Groups</span>
                        </button>
                        <button id="openDecryptionModalBtn" type="button"
                            class="px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-slate-400 hover:text-emerald-400 hover:border-emerald-400/50 hover:bg-emerald-400/10 transition text-xs flex items-center gap-2"
                            title="Set Decryption Password">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                            </svg>
                            <span>Set Password</span>
                        </button>
                        <a href="/archive"
                            class="px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-slate-400 hover:text-amber-400 hover:border-amber-400/50 hover:bg-amber-400/10 transition text-xs flex items-center gap-2"
                            title="View Archived Agents">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                            </svg>
                            <span>Archive</span>
                        </a>
                        <button id="voiceToggle" type="button"
                            class="px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-emerald-400 border-emerald-400/50 bg-emerald-400/10 hover:text-emerald-300 hover:border-emerald-400/50 transition text-xs flex items-center gap-2">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                            </svg>
                            <span>Voice On</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile Agent Dock (visible on small screens) -->
            <div class="mobile-agent-dock" id="mobileAgentDock">
                <!-- Navigation buttons are positioned outside the scrollable area -->
                <div class="dock-nav-container">
                    <!-- Left Navigation Arrow -->
                    <button class="dock-nav-btn dock-nav-btn--left" id="dockNavLeft" aria-label="Previous agents">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                    </button>

                    <!-- Right Navigation Arrow -->
                    <button class="dock-nav-btn dock-nav-btn--right" id="dockNavRight" aria-label="Next agents">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>

                    <div class="dock-carousel-stack">
                        <!-- Agent Carousel (scrollable) -->
                        <div class="dock-carousel" id="dockCarousel">
                            <!-- Agents will be populated dynamically by JavaScript -->
                        </div>


                    </div>
                </div>

                <!-- Position Indicator Dots -->
                <div class="dock-position-indicator" id="dockPositionIndicator">
                    <!-- Dots generated dynamically -->
                </div>

                <!-- Swipe/Drag Hints -->
                <div
                    class="dock-interaction-hints absolute bottom-1 left-0 right-0 flex justify-center items-center pointer-events-none opacity-50">
                    <div class="dock-drag-handle w-12 h-1 bg-white/20 rounded-full"></div>
                </div>
                <div class="dock-swipe-hint absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full flex justify-between px-12 pointer-events-none opacity-0 transition-opacity duration-500"
                    id="dockSwipeHint">
                    <svg class="w-6 h-6 text-white/20 animate-pulse" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    <svg class="w-6 h-6 text-white/20 animate-pulse" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </div>
            </div>

            <div class="council-chat-shortcuts">
            <!-- Group Back Button (shown in group zoom view, placed below the council header divider) -->
            <button id="groupBackBtn"
                class="hidden relative group-back-btn z-30 self-start ml-6 mt-3 flex items-center backdrop-blur-sm"
                aria-label="Back to all agents" title="Back to all agents">
                <span class="group-back-btn__icon" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M15 19l-7-7 7-7" />
                    </svg>
                </span>
                <span id="groupBackLabel">Back</span>
            </button>
            <div class="recent-chats-panel" title="Recent chats · Last 3 opened, newest to oldest">
                <div class="recent-chats-heading">
                    <svg class="recent-chats-heading__icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
                        <circle cx="8" cy="8" r="5.75" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 5v3.25l2.25 1.25" />
                    </svg>
                    <span id="recentChatsTitle">Recent<span class="sr-only"> chats</span></span>
                    <span id="recentChatsHint" class="sr-only">Last 3 opened · Newest first</span>
                </div>
                <nav id="recentChats" class="recent-chats" aria-labelledby="recentChatsTitle" aria-describedby="recentChatsHint" hidden></nav>
            </div>
            </div>

            <!-- Circular Agent Display -->
            <div id="councilCircle" class="flex-1 flex items-center justify-center p-8 min-h-0 relative">
                <div class="council-orbit relative w-full h-full">
                    <!-- Orbital rings that visualize urgency distance -->
                    <div class="council-rings pointer-events-none">
                        <div class="orbital-ring orbital-ring--urgent"></div>
                        <div class="orbital-ring orbital-ring--attention"></div>
                        <div class="orbital-ring orbital-ring--idle"></div>
                        <div class="orbital-label orbital-label--urgent">Urgent</div>
                        <div class="orbital-label orbital-label--attention">Needs reply</div>
                        <div class="orbital-label orbital-label--idle">All clear</div>
                    </div>

                    <!-- Center User Position -->
                    <div class="council-center absolute" style="left: 50%; top: 50%; transform: translate(-50%, -50%);">
                        <div id="councilCenterAvatar"
                            class="council-center__avatar w-16 h-16 rounded-full border border-slate-500/30 flex items-center justify-center shadow-2xl shadow-emerald-900/50 backdrop-blur-xl relative overflow-hidden group cursor-pointer transition-transform duration-500 hover:scale-105">
                            <img src="/images/center-planet-v2.jpg" alt="You" class="w-full h-full object-cover rounded-full" />
                            <div class="absolute inset-0 shadow-[inset_0_0_20px_rgba(0,0,0,0.5)] rounded-full"></div>
                        </div>
                        <div id="councilCenterGroup"
                            class="council-center__group hidden w-16 h-16 rounded-full border flex items-center justify-center shadow-2xl backdrop-blur-xl relative overflow-hidden cursor-default select-none">
                            <span id="councilCenterGroupText" class="council-center__group-text px-2"></span>
                            <div class="absolute inset-0 shadow-[inset_0_0_20px_rgba(0,0,0,0.55)] rounded-full"></div>
                        </div>
                        <p
                            id="councilCenterLabel"
                            class="text-center text-[10px] uppercase tracking-widest text-emerald-400/80 font-bold mt-4 text-shadow">
                            You</p>
                    </div>

                    <!-- Agent Seats (populated dynamically) -->
                    <div id="agentSeats" class="absolute inset-0">
                        <% if (agents && agents.length> 0) {
                            const ringRadii = { urgent: 26, attention: 36, idle: 46 };
                            const ringIndex = { urgent: 0, attention: 1, idle: 2 };
                            const orderedAgents = [...agents].sort((a, b) => (a.position || 0) - (b.position || 0));
                            const orbitLayout = {};
                            const totalAgents = orderedAgents.length;

                            if (totalAgents) {
                            orderedAgents.forEach((agent, index) => {
                            const ringKey = agent.lastMessagePriority === 'high' ? 'urgent' :
                            (agent.lastMessagePriority === 'normal' ? 'attention' : 'idle');
                            const radius = ringRadii[ringKey] ?? ringRadii.idle;
                            const ringIdx = ringIndex[ringKey] ?? ringIndex.idle;
                            const angle = (index * 360 / totalAgents) - 90;
                            const x = 50 + radius * Math.cos(angle * Math.PI / 180);
                            const y = 50 + radius * Math.sin(angle * Math.PI / 180);
                            orbitLayout[agent.agentId] = { x, y, ringKey, ringIndex: ringIdx };
                            });
                            }

                            orderedAgents.forEach((agent, index)=> {
                            const totalAgents = agents.length;
                            const positionValue = Number.isFinite(agent.position) ? agent.position :
                            Number(agent.position);
                            const safePosition = Number.isFinite(positionValue) ? positionValue : (index + 1);
                            const orbit = orbitLayout[agent.agentId] || { x: 50, y: 50, ringKey: 'idle', ringIndex:
                            ringIndex.idle };
                            const ringKey = orbit.ringKey;
                            const ringIdx = orbit.ringIndex;
                            const x = orbit.x;
                            const y = orbit.y;

                            // statusLabel uses lastMessagePriority for ring styling
                            const statusLabel = ringKey;
                            const needsAttention = agent.highestPriority === 'high' || agent.unreadCount > 0;

                            // Dynamic sizing
                            // Dynamic sizing - Standardized
                            let sizeClass = 'w-14 h-14';
                            %>
                            <div class="agent-seat absolute cursor-pointer transition-all duration-300 agent-seat--<%= statusLabel %> <%= needsAttention ? 'agent-seat--active' : '' %>"
                                data-agent-id="<%= agent.agentId %>" data-agent-name="<%= agent.name %>"
                                data-agent-type="<%= agent.agentType || 'standard' %>"
                                data-agent-external-provider="<%= agent.externalProvider || '' %>"
                                data-agent-priority="<%= agent.highestPriority %>"
                                data-agent-last-message-priority="<%= agent.lastMessagePriority || 'low' %>"
                                data-agent-unread="<%= agent.unreadCount %>"
                                data-agent-last-message="<%= agent.lastMessageTime ? agent.lastMessageTime : '' %>"
                                data-agent-last-activity="<%= agent.lastActivityTime ? agent.lastActivityTime : '' %>"
                                data-agent-last-heartbeat="<%= agent.lastWorkingHeartbeatTime ? agent.lastWorkingHeartbeatTime : '' %>"
                                data-agent-working="<%= agent.isWorking ? 'true' : 'false' %>"
                                data-agent-ring="<%= ringKey %>" data-agent-ring-index="<%= ringIdx %>"
                                data-agent-index="<%= index %>"
                                style="left: <%= x %>%; top: <%= y %>%; transform: translate(-50%, -50%);">
                                <!-- Agent Number Badge -->
                                <div
                                    class="agent-number-badge absolute -top-6 left-1/2 -translate-x-1/2 z-30 pointer-events-none">
                                    <span
                                        class="text-[10px] font-mono font-bold text-sky-400/70 bg-slate-900/80 px-1.5 py-0.5 rounded border border-sky-400/30">
                                        <%= safePosition %>
                                    </span>
                                </div>
                                <!-- Agent Avatar -->
                                <div class="agent-avatar relative group w-fit mx-auto">
                                    <%- DeviceBadge.render(agent.device) %>
                                    <div
                                        class="<%= sizeClass %> rounded-full relative z-10 transition-transform duration-300 group-hover:scale-110 overflow-hidden border-2 border-white/10 shadow-2xl bg-slate-900">
                                        <div class="w-full h-full marble-container">
                                            <%- agent.marbleSvg %>
                                        </div>
                                        <!-- Agent Initials Overlay -->
                                        <div
                                            class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                            <span class="text-white font-bold text-xl opacity-90"
                                                style="text-shadow: 0 2px 4px rgba(0,0,0,0.8), 0 0 2px rgba(0,0,0,0.5);">
                                                <%= agent.name.substring(0, 2).toUpperCase() %>
                                            </span>
                                        </div>
                                        <div
                                            class="absolute inset-0 rounded-full shadow-[inset_0_0_10px_rgba(0,0,0,0.5)] pointer-events-none">
                                        </div>
                                    </div>

                                    <!-- Status Indicator -->
                                    <% if (agent.highestPriority==='high' ) { %>
                                        <div
                                            class="absolute -top-1 -right-1 z-20 w-6 h-6 rounded-full bg-red-500 border-2 border-slate-900 animate-pulse shadow-[0_0_15px_rgba(239,68,68,0.6)] flex items-center justify-center">
                                            <span class="text-white text-xs font-bold">!</span>
                                        </div>
                                        <% } else if (agent.unreadCount> 0) { %>
                                            <div
                                                class="absolute -top-1 -right-1 z-20 w-6 h-6 rounded-full bg-amber-400 border-2 border-slate-900 flex items-center justify-center shadow-[0_0_15px_rgba(251,191,36,0.6)]">
                                                <span class="text-slate-900 text-xs font-bold">
                                                    <%= agent.unreadCount %>
                                                </span>
                                            </div>
                                            <% } else if (agent.isWorking) { %>
                                                <div class="absolute bottom-0 right-0 z-20 w-5 h-5 rounded-md bg-amber-500 border-2 border-slate-900 flex items-center justify-center shadow-[0_0_10px_rgba(245,158,11,0.6)] animate-pulse"
                                                    title="Agent is working...">
                                                    <span class="text-[8px]">🛠️</span>
                                                </div>
                                                <% } else { %>
                                                    <div class="absolute bottom-0 right-0 z-20 w-3 h-3 rounded-full bg-emerald-400 border-2 border-slate-900 shadow-[0_0_10px_rgba(52,211,153,0.6)]"
                                                        title="Waiting for instructions">
                                                    </div>
                                                    <% } %>
                                </div>

                                <!-- Agent Name -->
                                <div
                                    class="absolute top-full left-1/2 -translate-x-1/2 mt-3 w-max text-center opacity-80 group-hover:opacity-100 transition-opacity pointer-events-none">
                                    <p
                                        class="text-[10px] font-bold uppercase tracking-wider text-slate-200 text-shadow-sm">
                                        <%= agent.name %>
                                    </p>
                                </div>

                                <!-- Connection Line to Center -->
                                <svg class="connection-line absolute"
                                    style="position: absolute; top: 50%; left: 50%; pointer-events: none; overflow: visible; width: 200px; height: 200px; transform: translate(-50%, -50%); z-index: -1;">
                                    <line x1="100" y1="100" x2="100" y2="100" stroke="url(#gradient-<%= index %>)"
                                        stroke-width="1" />
                                    <defs>
                                        <linearGradient id="gradient-<%= index %>" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="rgba(16, 185, 129, 0)" />
                                            <stop offset="100%" stop-color="rgba(16, 185, 129, 0.4)" />
                                        </linearGradient>
                                    </defs>
                                </svg>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <div class="council-empty-state text-center text-slate-400">
                                            <svg class="w-16 h-16 mx-auto mb-4 text-slate-600 opacity-50" fill="none"
                                                stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                            </svg>
                                            <p class="text-sm font-medium tracking-wide">No agents in your
                                                council yet</p>
                                            <p class="text-xs text-slate-600 mt-1">Agents will appear here once
                                                they connect</p>
                                            <a class="workspace-setup-link" href="/for-agents">Connect your first agent →</a>
                                        </div>
                                    </div>
                                    <% } %>
                    </div>
                </div>

                <!-- Keyboard Hints -->
                <div class="absolute bottom-4 left-0 right-0 text-center pointer-events-none">
                    <p class="text-[10px] text-slate-500 font-medium tracking-wide uppercase opacity-60">
                        <span class="mx-1"><kbd class="font-sans">Alt+J</kbd> switch view</span>
                        <span class="mx-1">•</span>
                        <span class="mx-1"><kbd class="font-sans">←/→</kbd> or <kbd class="font-sans">J/K</kbd> to
                            move</span>
                        <span class="mx-1">•</span>
                        <span class="mx-1"><kbd class="font-sans">Enter</kbd> to chat</span>
                        <span class="mx-1">•</span>
                        <span class="mx-1"><kbd class="font-sans">Esc</kbd> back</span>
                    </p>
                </div>
            </div>


            <div id="councilListResizeHandle"
                class="dashboard-resize-handle dashboard-resize-handle--horizontal hidden xl:flex"
                role="separator"
                aria-orientation="horizontal"
                aria-label="Resize agent list"
                tabindex="0"></div>

            <%
                const initialNowMs = Date.now();
                const initialActiveAgentsCount = agents ? agents.filter(a => {
                    if (a.isWorking) return true;
                    const actMs = a.lastActivityTime ? new Date(a.lastActivityTime).getTime() : NaN;
                    const seenMs = a.lastSeenAt ? new Date(a.lastSeenAt).getTime() : NaN;
                    const hbMs = a.lastWorkingHeartbeatTime ? new Date(a.lastWorkingHeartbeatTime).getTime() : NaN;
                    return [actMs, seenMs, hbMs].some(ms => Number.isFinite(ms) && (initialNowMs - ms <= 5 * 60 * 1000));
                }).length : 0;
            %>
            <div id="councilListSection" class="council-list-section">
                <!-- Quick Stats Bar (Now Header) - Moved ABOVE list -->
                <div id="mobileStatsToggle"
                    class="px-6 py-3 border-t border-white/5 bg-black/20 backdrop-blur group relative transition-colors z-20">
                    <div class="grid grid-cols-3 gap-4 text-center text-xs items-center">
                        <div class="flex items-center justify-center gap-1" role="group" aria-label="Filter agents by total or active">
                            <button type="button" id="statsFilterTotalBtn" data-agent-status-filter="all" aria-pressed="true"
                                class="agent-status-filter-btn is-active px-1.5 py-0.5 rounded-lg text-center"
                                title="Show all agents">
                                <p class="text-emerald-400 font-bold text-lg" id="statsTotal">
                                    <%= agents ? agents.length : 0 %>
                                </p>
                                <p class="text-slate-400">Total Agents</p>
                            </button>
                            <span class="text-slate-600 font-bold select-none">/</span>
                            <button type="button" id="statsFilterActiveBtn" data-agent-status-filter="active" aria-pressed="false"
                                class="agent-status-filter-btn px-1.5 py-0.5 rounded-lg text-center"
                                title="Filter by active agents">
                                <p class="text-sky-400 font-bold text-lg" id="statsActive">
                                    <%= initialActiveAgentsCount %>
                                </p>
                                <p class="text-slate-400">Active Agents</p>
                            </button>
                        </div>
                        <div class="flex items-center justify-center">
                            <button type="button" id="statsFilterAttentionBtn" data-agent-status-filter="attention" aria-pressed="false"
                                class="agent-status-filter-btn px-1.5 py-0.5 rounded-lg text-center"
                                title="Filter by agents needing attention">
                                <p class="text-amber-400 font-bold text-lg" id="statsAttention">
                                    <%= agents ? agents.filter(a=> a.lastMessagePriority === 'normal').length : 0 %>
                                </p>
                                <p class="text-slate-400">Need Attention</p>
                            </button>
                        </div>
                        <div class="flex items-center justify-center">
                            <button type="button" id="statsFilterUrgentBtn" data-agent-status-filter="urgent" aria-pressed="false"
                                class="agent-status-filter-btn px-1.5 py-0.5 rounded-lg text-center"
                                title="Filter by urgent agents">
                                <p class="text-red-400 font-bold text-lg" id="statsUrgent">
                                    <%= agents ? agents.filter(a=> a.lastMessagePriority === 'high').length : 0 %>
                                </p>
                                <p class="text-slate-400">Urgent</p>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Agent List Panel (scrollable list below orbit) -->
                <div id="agentListPanel" class="agent-list-panel">
                    <div class="agent-list-header flex items-center justify-between">
                        <div class="agent-list-header__meta agent-list-filter-pills flex items-center gap-1.5" role="group" aria-label="Filter agent list by total or active">
                            <button type="button" class="agent-list-filter-pill is-active" data-agent-status-filter="all" aria-pressed="true" title="Show all agents">
                                <span class="agent-list-title">Total Agents</span>
                                <span class="agent-list-count" id="agentListCount">
                                    <%= agents ? agents.length : 0 %>
                                </span>
                            </button>
                            <span class="agent-list-filter-divider" aria-hidden="true">/</span>
                            <button type="button" class="agent-list-filter-pill" data-agent-status-filter="active" aria-pressed="false" title="Filter by active agents">
                                <span class="agent-list-title">Active Agents</span>
                                <span class="agent-list-count agent-list-count--active" id="agentListActiveCount">
                                    <%= initialActiveAgentsCount %>
                                </span>
                            </button>
                        </div>
                        <div class="agent-list-search">
                            <label class="sr-only" for="agentListSearchInput">Search agents</label>
                            <input
                                id="agentListSearchInput"
                                class="agent-list-search__input"
                                type="search"
                                name="agent_search_query"
                                placeholder="Search agents"
                                value=""
                                readonly
                                autocomplete="off"
                                autocorrect="off"
                                autocapitalize="none"
                                inputmode="search"
                                data-form-type="other"
                                data-lpignore="true"
                                data-1p-ignore="true"
                                data-bwignore="true"
                                spellcheck="false"
                                aria-label="Search agents">
                        </div>
                    </div>
                    <div class="agent-list-scroll" id="agentListScroll">
                    <% if (agents && agents.length> 0) {
                        const orderedAgents = [...agents].sort((a, b) => (a.position || 0) - (b.position || 0));
                        orderedAgents.forEach((agent, index) => {
                        const ringKey = agent.lastMessagePriority === 'high' ? 'urgent' :
                        (agent.lastMessagePriority === 'normal' ? 'attention' : 'idle');
                        const needsAttention = agent.highestPriority === 'high' || agent.unreadCount > 0;
                        %>
                        <div class="agent-list-item agent-list-item--<%= ringKey %> <%= needsAttention ? 'agent-list-item--attention' : '' %> group"
                            data-agent-id="<%= agent.agentId %>" data-agent-name="<%= agent.name %>"
                            data-agent-type="<%= agent.agentType || 'standard' %>"
                            data-agent-external-provider="<%= agent.externalProvider || '' %>"
                            data-agent-priority="<%= agent.highestPriority %>"
                            data-agent-unread="<%= agent.unreadCount %>"
                            data-agent-last-activity="<%= agent.lastActivityTime ? agent.lastActivityTime : '' %>"
                            data-agent-last-message="<%= agent.lastMessageTime ? agent.lastMessageTime : '' %>"
                            data-agent-last-heartbeat="<%= agent.lastWorkingHeartbeatTime ? agent.lastWorkingHeartbeatTime : '' %>"
                            data-agent-working="<%= agent.isWorking ? 'true' : 'false' %>">
                            <div class="agent-list-item__avatar">
                                <div class="agent-list-item__marble">
                                    <%- agent.marbleSvg %>
                                </div>
                                <span class="agent-list-item__initials">
                                    <%= agent.name.substring(0, 2).toUpperCase() %>
                                </span>
                            </div>
                            <div class="agent-list-item__info">
                                <span class="agent-list-item__name">
                                    <%= agent.name %>
                                </span>
                                <div class="agent-list-item__status-row">
                                    <span class="agent-list-item__status">
                                        <% if (agent.highestPriority==='high' ) { %>
                                            <span class="agent-list-item__badge agent-list-item__badge--urgent">!</span>
                                            Urgent
                                            <% } else if (agent.unreadCount> 0) { %>
                                                <span class="agent-list-item__badge agent-list-item__badge--unread">
                                                    <%= agent.unreadCount %>
                                                </span> Unread
                                                <% } else { %>
                                                    <span
                                                        class="agent-list-item__badge agent-list-item__badge--idle"></span>
                                                    Ready
                                                    <% } %>
                                    </span>
                                    <div class="agent-list-item__timestamps">
                                        <!-- Populated by JS on load -->
                                    </div>
                                </div>
                            </div>
                            <div class="agent-list-item__actions flex items-center gap-1">
                                <% if (process.env.FEATURE_SHARED_CONVERSATIONS === 'true' && process.env.FEATURE_GUEST_SHARING === 'true') { %>
                                    <a href="/guest-sharing?agentId=<%= encodeURIComponent(agent.agentId) %>"
                                        class="agent-list-share-btn px-2 py-1 rounded border border-cyan-500/40 text-cyan-300 text-[10px] font-medium hover:bg-cyan-500/10"
                                        data-agent-share-link="<%= agent.agentId %>"
                                        aria-label="Share <%= agent.name %> with guests">Share</a>
                                <% } %>
                                <!-- Open in Side Panel Button -->
                                <button type="button"
                                    class="chat-tile__pin-btn agent-list-pin-btn"
                                    data-agent-id="<%= agent.agentId %>" data-agent-name="<%= agent.name %>"
                                    data-agent-external-provider="<%= agent.externalProvider || '' %>"
                                    title="Pin chat to side panel" aria-label="Pin <%= agent.name %> chat to side panel">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 17.5V22m0-4.5l4.2-4.2a6 6 0 10-8.4 0L12 17.5z" />
                                    </svg>
                                </button>
                                <div class="agent-list-item__arrow">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 5l7 7-7 7" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <% }); } else { %>
                            <div class="agent-list-empty">
                                <p>No agents connected</p>
                                <a class="workspace-setup-link" href="/for-agents">Connect an agent →</a>
                            </div>
                            <% } %>
                    </div>
                    <% if (process.env.FEATURE_SHARED_CONVERSATIONS === 'true' && inPlaceSharingEnabled) { %>
                    <section id="sharedConversationSection" hidden aria-label="Shared conversations">
                        <div class="shared-conversation-heading"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M22 21v-2a4 4 0 00-3-3.87"/><circle cx="9" cy="7" r="4"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><h2>Shared with you</h2><span id="sharedConversationCount">0</span></div>
                        <div id="incomingSharingInvitations" class="space-y-1"></div>
                        <div id="sharedConversationList" class="space-y-1"></div>
                    </section>
                    <% } %>
                </div>
            </div>

        </div>

        <div id="councilResizeHandle"
            class="dashboard-resize-handle hidden xl:flex"
            role="separator"
            aria-orientation="vertical"
            aria-label="Resize council chamber"
            tabindex="0"></div>

        <!-- Multi-Chat Side Panels Container -->
        <div id="multiChatContainer" class="multi-chat-container">
            <!-- Message Panel (Main Chat) -->
            <aside
                class="chat-tile chat-tile--main glass-panel flex flex-col h-full min-h-0 relative chat-drop-container">
                <!-- Selected Agent Header -->
                <div id="agentPanelHeader" class="hidden px-5 pt-3 pb-2 border-b border-white/5 relative z-20">
                    <div class="flex items-start gap-3">
                        <button id="selectedAgentActionIcon" type="button" aria-label="Agent actions" aria-haspopup="dialog" title="Agent actions and sharing"
                            class="w-14 h-14 rounded-full border-2 border-emerald-400/60 shadow-lg shadow-emerald-500/30 relative overflow-hidden bg-slate-900">
                            <div id="selectedAgentImage" class="w-full h-full marble-container"></div>
                            <!-- Agent Initials Overlay in Chat Header -->
                            <div id="selectedAgentInitials"
                                class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                <span class="text-white font-bold text-lg opacity-90"
                                    style="text-shadow: 0 2px 4px rgba(0,0,0,0.8), 0 0 2px rgba(0,0,0,0.5);"></span>
                            </div>
                            <div class="absolute inset-0 shadow-[inset_0_0_10px_rgba(0,0,0,0.5)]"></div>
                        </button>
                        <div class="flex-1 relative group cursor-pointer" id="agentHeaderInfo">
                            <div class="flex items-center gap-3">
                                <h3 id="selectedAgentName"
                                    class="text-lg font-semibold text-white group-hover:text-emerald-300 transition-colors">
                                </h3>
                                <button id="selectedChatContextStatus" type="button" hidden class="shared-participants-button"
                                    aria-label="Manage sharing" title="Manage sharing" aria-haspopup="dialog" aria-controls="shareExistingChatDialog" aria-expanded="false">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M15 3.13a4 4 0 0 1 0 7.75"/><circle cx="9" cy="7" r="4"/>
                                    </svg>
                                    <span data-shared-participant-count aria-hidden="true">…</span>
                                </button>
                                <button id="leaveSharedConversationHeaderBtn" type="button" hidden class="min-h-11 rounded-lg border border-slate-700 px-2 text-xs text-slate-300 hover:text-amber-200">Leave</button>
                                <button id="fastModeChatListToggle" type="button"
                                    class="fast-mode-chat-list-toggle"
                                    aria-label="Open all chats and groups" title="Open all chats and groups" aria-controls="agentListPanel" aria-expanded="false">
                                    <%- include('partials/agent-list-icon') %>
                                </button>
                                <span id="selectedAgentWorkingIndicator" class="chat-header__working-indicator"
                                    style="display:none;" role="img" tabindex="0"
                                    aria-label="Agent is working" data-hint="Agent is working"></span>
                                <span id="agentUnreadBadge" class="chat-header__unread hidden" role="status"></span>
                                <!-- Inter-Agent Communication Toggle -->
                                <div id="interAgentStatsInline"
                                    class="hidden flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-800/50 border border-slate-700/50 cursor-pointer hover:bg-slate-700/50 transition-all text-[10px]"
                                    title="Click to toggle agent-to-agent communication">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                    </svg>
                                    <span id="interAgentStatsStatus" class="font-medium text-slate-400">A2A Off</span>
                                </div>
                            </div>
                            <p id="agentLastActive" class="text-xs text-slate-400 mt-0.5"></p>

                            <!-- Context Menu (Floating) -->
                            <div id="agentContextMenu"
                                class="hidden absolute top-full left-0 mt-2 w-72 bg-slate-800 border border-slate-700 rounded-lg shadow-xl z-50 overflow-hidden">
                                <% if (process.env.FEATURE_SHARED_CONVERSATIONS === 'true') { %>
                                <button id="shareAgentFromContextMenu" type="button" class="w-full px-4 py-3 text-left text-xs text-cyan-300 hover:bg-cyan-900/30 border-b border-slate-700/50">Share this agent</button>
                                <% } %>
                                <div class="agent-menu-stats px-3 py-2 border-b border-slate-700/50 bg-slate-900/40 text-[10px] space-y-1">
                                    <p class="uppercase tracking-wide text-slate-500 font-semibold">Agent Stats</p>
                                    <div class="flex items-center justify-between text-slate-300"><span class="text-slate-400">Messages</span><span class="font-mono" data-agent-stat="message-count">—</span></div>
                                    <div class="flex items-center justify-between text-slate-300"><span class="text-slate-400">Last heartbeat</span><span class="font-mono" data-agent-stat="last-heartbeat">—</span></div>
                                    <div class="flex items-center justify-between text-slate-300"><span class="text-slate-400">Visible chars</span><span class="font-mono" data-agent-stat="visible-chars">—</span></div>
                                    <div class="flex items-center justify-between text-slate-300"><span class="text-slate-400">Last poll</span><span class="font-mono" data-agent-stat="last-poll">—</span></div>
                                    <div class="flex items-center justify-between gap-2 text-slate-300"><span class="text-slate-400">Computer</span><span class="font-mono truncate max-w-[120px]" data-agent-stat="machine-name">—</span></div>
                                    <div class="flex items-center justify-between gap-2 text-slate-300"><span class="text-slate-400">IP</span><span class="font-mono truncate max-w-[120px]" data-agent-stat="machine-ip">—</span></div>
                                    <div class="flex items-center justify-between gap-2 text-slate-300"><span class="text-slate-400">Folder</span><span class="font-mono truncate max-w-[120px]" data-agent-stat="folder-name">—</span></div>
                                    <div class="space-y-0.5 text-slate-300">
                                        <span class="text-slate-400 block">Project path</span>
                                        <span class="font-mono text-[9px] block break-all" data-agent-stat="project-path">—</span>
                                    </div>
                                    <div class="space-y-0.5 text-slate-300">
                                        <span class="text-slate-400 block">Folder path</span>
                                        <span class="font-mono text-[9px] block break-all" data-agent-stat="folder-path">—</span>
                                    </div>
                                </div>
                                <button id="copyAgentNameBtn" type="button"
        class="w-full px-4 py-3 text-left text-xs text-cyan-300 hover:bg-cyan-900/30 hover:text-cyan-200 transition-colors flex items-center gap-2 border-b border-slate-700/50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="8" y="8" width="12" height="13" rx="2" stroke-width="2" />
            <path d="M16 8V5a2 2 0 00-2-2H5a2 2 0 00-2 2v9a2 2 0 002 2h3" stroke-width="2" />
        </svg>
        Copy name
    </button>
    <button type="button" data-open-agent-brief class="w-full px-4 py-3 text-left text-xs text-cyan-300 hover:bg-cyan-900/30 border-b border-slate-700/50">Identity &amp; goals (optional)</button>
    <button id="updateAgentBtn" type="button" hidden
        class="hidden w-full px-4 py-3 text-left text-xs text-cyan-300 hover:bg-cyan-900/30 hover:text-cyan-200 transition-colors flex items-center gap-2 border-b border-slate-700/50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M5.1 15a7 7 0 0011.6 3L20 14M4 10l3.3-4A7 7 0 0118.9 9" />
        </svg>
        Update agent
    </button>
    <button id="clearConversationBtn"
                                    class="w-full px-4 py-3 text-left text-xs text-amber-300 hover:bg-amber-900/30 hover:text-amber-200 transition-colors flex items-center gap-2 border-b border-slate-700/50">
                                    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Clear Conversation
                                </button>
                                <button id="hideAllMessagesBtn"
                                    class="w-full px-4 py-3 text-left text-xs text-cyan-300 hover:bg-cyan-900/30 hover:text-cyan-200 transition-colors flex items-center gap-2 border-b border-slate-700/50">
                                    <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                    </svg>
                                    Hide All Messages
                                </button>
                                <button id="archiveAgentBtn"
                                    class="w-full px-4 py-3 text-left text-xs text-amber-300 hover:bg-amber-900/30 hover:text-amber-200 transition-colors flex items-center gap-2 border-b border-slate-700/50">
                                    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                                    </svg>
                                    Archive Agent
                                </button>
                                <button id="deleteAgentBtn"
                                    class="w-full px-4 py-3 text-left text-xs text-red-300 hover:bg-red-900/30 hover:text-red-200 transition-colors flex items-center gap-2">
                                    <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Delete Agent
                                </button>
                                <div class="agent-menu-groups" data-agent-groups></div>
                            </div>
                        </div>
                        <div class="chat-header__actions">
                        <button id="pinToSideBtn" type="button" class="hidden chat-header__pin-btn"
                            title="Pin selected chat to side panel" aria-label="Pin selected chat to side panel"
                            aria-pressed="false">
                            <span class="pin-chat-icon" aria-hidden="true">
