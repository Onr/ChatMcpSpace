                        </div>
                        <div class="relative">
                            <textarea id="userMessageInput" rows="3"
                                class="w-full bg-white/5 border border-white/10 focus:border-emerald-400/70 focus:ring-0 text-sm text-slate-100 rounded-xl p-3 pr-24 placeholder:text-slate-500 transition resize-none"
                                placeholder="Type your message..." disabled></textarea>
                            <!-- File Input Button for general attachments -->
                            <label for="generalFileInput" id="generalFileUploadLabel"
                                class="absolute right-12 bottom-3 w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 hover:bg-sky-500/20 hover:text-sky-400 text-slate-400 cursor-pointer transition disabled:opacity-40 disabled:cursor-not-allowed"
                                title="Attach files (PDF, TXT, etc.)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                                </svg>
                            </label>
                            <input type="file" id="generalFileInput"
                                multiple
                                class="hidden" disabled />
                            <!-- Image Input Button -->
                            <label for="imageFileInput" id="imageUploadLabel"
                                class="absolute right-3 bottom-3 w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 hover:bg-emerald-500/20 hover:text-emerald-400 text-slate-400 cursor-pointer transition disabled:opacity-40 disabled:cursor-not-allowed"
                                title="Attach photos or videos">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </label>
                            <input type="file" id="imageFileInput" accept="image/*,video/*"
                                multiple class="hidden" disabled />
