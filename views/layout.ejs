<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content">
  <title>
    <%= typeof title !=='undefined' ? title : 'ChatMCPSpace' %>
  </title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/css/rich-rendering.css">
  <style>
    /* Styles moved to public/css/style.css */

    /* Onboarding callout - Redesigned */
    .onboarding-callout {
      position: fixed;
      z-index: 99999;
      pointer-events: none;
      margin: 0;
      padding: 0;
      opacity: 0;
      transform: translateX(-50%) translateY(10px);
      transition: opacity 0.3s ease, transform 0.3s ease;
      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5));
    }

    .onboarding-callout.is-visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .onboarding-callout__content {
      background: #10b981;
      /* Emerald 500 */
      color: #022c22;
      /* Emerald 950 */
      padding: 12px 24px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 0.9rem;
      white-space: nowrap;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    /* CSS Triangle Arrow */
    .onboarding-callout__content::before {
      content: '';
      position: absolute;
      top: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 8px solid transparent;
      border-right: 8px solid transparent;
      border-bottom: 8px solid #10b981;
    }

    .onboarding-callout__title {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.8;
      margin-bottom: 2px;
    }

    .onboarding-callout__message {
      font-size: 0.95rem;
      font-weight: 700;
    }

    /* Settings button highlight */
    .settings-highlight {
      position: relative;
      z-index: 50;
      animation: settings-pulse 2s infinite;
      background: rgba(16, 185, 129, 0.1) !important;
      border-color: #10b981 !important;
    }

    @keyframes settings-pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }
  </style>
</head>

<body class="min-h-screen text-slate-100 antialiased <%= typeof pageBodyClass !== 'undefined' ? pageBodyClass : '' %>">
  <script nonce="<%= cspNonce %>">
    // Apply persisted mobile Fast Mode before dashboard markup paints, so the
    // full stats/header chrome does not flash or remain visible while JS loads.
    (function () {
      try {
        if (!/^\/dashboard(?:\/)?$/.test(window.location.pathname)) return;
        var mobileShell = window.matchMedia && (
          window.matchMedia('(max-width: 1023px)').matches ||
          window.matchMedia('(pointer: coarse) and (orientation: landscape) and (max-height: 600px)').matches
        );
        if (!mobileShell) return;
        document.body.classList.add('dashboard-mobile');
        if (window.localStorage && window.localStorage.getItem('dashboardFastMode') === '1') {
          document.body.classList.add('dashboard-fast-mode');
        }
      } catch (_) {
        // Keep initial render resilient if storage or matchMedia is unavailable.
      }
    })();
  </script>
  <% if (user) { %>
    <!-- Email Verification Banner -->
    <% if (typeof emailVerified !=='undefined' && emailVerified===false) { %>
      <div class="bg-amber-500/10 border-b border-amber-500/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <p class="text-sm text-amber-200">
                <strong>Verify your email</strong> to unlock all features. Check your inbox for the verification link.
              </p>
            </div>
            <a href="/verify-email-sent"
              class="text-sm font-medium text-amber-400 hover:text-amber-300 transition whitespace-nowrap">
              Resend Email →
            </a>
          </div>
        </div>
      </div>
      <% } %>

        <nav class="px-4 sm:px-6 lg:px-8 pt-6 overflow-visible">
          <div class="max-w-7xl mx-auto overflow-visible">
            <div class="glass-panel px-6 py-4 flex flex-wrap items-center justify-between gap-4 overflow-visible">
              <a href="/architecture" class="group flex flex-col rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-400/70" aria-label="Open Chat MCP Space instructions and information" title="Instructions and information">
                <div class="flex items-center gap-3 transition-opacity group-hover:opacity-80">
                  <svg class="w-12 h-12 flex-shrink-0" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
                    <!-- Central command center -->
                    <circle cx="128" cy="128" r="56" fill="none" stroke="#22d3ee" stroke-width="4" />
                    <!-- Inner thin orbit ring -->
                    <circle cx="128" cy="128" r="72" fill="none" stroke="#0891b2" stroke-width="2" />
                    <!-- Outer thin orbit ring -->
                    <circle cx="128" cy="128" r="88" fill="none" stroke="#06b6d4" stroke-width="3" />
                    <!-- Agent dots -->
                    <circle cx="128" cy="56" r="7" fill="#22d3ee" />
                    <circle cx="190.2" cy="65.8" r="7" fill="#14b8a6" />
                    <circle cx="216" cy="128" r="7" fill="#22d3ee" />
                    <circle cx="178.9" cy="178.9" r="7" fill="#14b8a6" />
                    <circle cx="128" cy="216" r="7" fill="#22d3ee" />
                    <circle cx="65.8" cy="190.2" r="7" fill="#14b8a6" />
                    <circle cx="40" cy="128" r="7" fill="#22d3ee" />
                    <circle cx="65.8" cy="65.8" r="7" fill="#14b8a6" />
                  </svg>
                  <p class="text-sm sm:text-base font-bold uppercase tracking-[0.15em] text-emerald-500/80">Chat MCP Space</p>
                </div>
                <p class="text-[10px] text-slate-400 mt-0.5" style="display: none;">Monitor every agent, maintain
                  control, and delegate with focus.</p>
              </a>
              <div class="flex flex-wrap items-center gap-2 text-sm text-slate-300 overflow-visible nav-right-buttons">
                <button id="mobileNavActionsToggle" type="button"
                  class="mobile-nav-actions-toggle hidden rounded-lg border border-slate-700/50 text-slate-200 hover:bg-slate-800 transition font-medium"
                  aria-label="Open navigation actions" aria-expanded="false">
                  <svg class="mobile-nav-actions-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="4" y1="7" x2="20" y2="7"></line>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <line x1="4" y1="17" x2="20" y2="17"></line>
                  </svg>
                  <span class="mobile-nav-actions-toggle__label">Menu</span>
                </button>
                <div id="mobileNavActionsMenu" class="mobile-nav-actions-menu">
                  <button id="mobileFastModeToggle" type="button" class="mobile-fast-mode-toggle"
                    aria-pressed="false" aria-label="Enable fast mobile mode" title="Toggle fast mobile mode">
                    <span class="mobile-fast-mode-toggle__copy">
                      <span class="mobile-fast-mode-toggle__label">Fast Mode</span>
                      <span class="mobile-fast-mode-toggle__state">Off</span>
                    </span>
                    <span class="mobile-fast-mode-toggle__switch" aria-hidden="true">
                      <span class="mobile-fast-mode-toggle__thumb"></span>
                    </span>
                  </button>
                  <span
                    class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs tracking-wide uppercase">Signed
                    in
                    as <%= user.email %></span>
                  <button id="feedbackTriggerBtn" type="button"
                    class="px-3 py-1.5 rounded-lg border border-slate-700/50 hover:bg-slate-800 transition inline-block text-xs font-medium">Feedback</button>
                  <% const inPlaceSharingEnabled = typeof featureInPlaceAgentSharing === 'boolean' ? featureInPlaceAgentSharing : process.env.FEATURE_IN_PLACE_AGENT_SHARING === 'true'; %>
                  <% if (process.env.FEATURE_SHARED_CONVERSATIONS === 'true' && !inPlaceSharingEnabled) { %>
                    <a href="/shared" class="px-3 py-1.5 rounded-lg border border-slate-700/50">Shared chats</a>
                    <% if (process.env.FEATURE_GUEST_SHARING === 'true') { %>
                      <a href="/guest-sharing" class="px-3 py-1.5 rounded-lg border border-slate-700/50">Guest sharing</a>
                    <% } %>
                  <% } %>
                  <div class="relative overflow-visible" id="settingsButtonWrapper">
                    <% const navIsSettings = typeof currentPath === 'string' &&
                      (currentPath === '/settings' || currentPath.startsWith('/settings/')); %>
                    <a href="<%= navIsSettings ? '/dashboard' : '/settings' %>" id="navToggleButton"
                      class="px-3 py-1.5 rounded-lg border border-slate-700/50 hover:bg-slate-800 transition inline-block text-xs font-medium relative">
                      <%= navIsSettings ? 'Dashboard' : 'Settings' %>
                    </a>
                  </div>
                  <% if (typeof showSetupShortcut !=='undefined' && showSetupShortcut) { %>
                    <button id="navCopySetupButton" type="button" onclick="copyMainCLIScript(this)"
                      class="hidden md:inline-flex px-3 py-1.5 rounded-lg border border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/10 transition items-center gap-2 text-xs font-medium">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                      </svg>
                      Setup Script
                    </button>
                    <% if (typeof apiKey !== 'undefined' && apiKey) { %>
                    <button id="navCopyApiKeyButton" type="button" data-api-key="<%= apiKey %>"
                      class="hidden md:inline-flex px-3 py-1.5 rounded-lg border border-slate-700/60 text-slate-200 hover:bg-white/5 transition items-center gap-2 text-xs font-medium"
                      onclick="copyNavApiKey(this)">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V9a2 2 0 00-2-2h-2M8 5a2 2 0 012 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m-6 9h4" />
                      </svg>
                      Copy API Key
                    </button>
                    <% } %>
                    <% } %>
                      <a href="/logout" id="navLogoutLink"
                        class="px-3 py-1.5 rounded-lg border border-red-500/30 text-red-400 hover:bg-red-500/10 transition text-xs font-medium">Logout</a>
                </div>
              </div>
            </div>
          </div>
        </nav>

        <script nonce="<%= cspNonce %>">
          // Onboarding tooltip for first-time users
          (function () {
            const ONBOARDING_KEY = 'chatmcp_setup_script_onboarding_v1'; // Key for setup script hint
            const setupBtn = document.getElementById('navCopySetupButton');

            // If no setup button, user doesn't have it enabled - skip onboarding
            if (!setupBtn) return;

            const hasSeenOnboarding = localStorage.getItem(ONBOARDING_KEY);
            if (hasSeenOnboarding) return;

            // Create callout element
            const callout = document.createElement('div');
            callout.className = 'onboarding-callout';
            callout.innerHTML = `
        <div class="onboarding-callout__content">
          <div class="onboarding-callout__title">👋 First Time?</div>
          <div class="onboarding-callout__message">Click to copy, then paste in your workspace</div>
        </div>
      `;
            document.body.appendChild(callout);

            function positionCallout() {
              const rect = setupBtn.getBoundingClientRect();

              // Center below the button using CSS transform for perfect centering
              // Round values to avoid sub-pixel rendering issues
              const top = rect.bottom + 8;
              const left = rect.left + (rect.width / 2);

              callout.style.top = `${Math.round(top)}px`;
              callout.style.left = `${Math.round(left)}px`;
            }

            // Show and position - highlight the setup button
            setupBtn.classList.add('settings-highlight');

            // Wait for layout
            requestAnimationFrame(() => {
              positionCallout();
              requestAnimationFrame(() => {
                callout.classList.add('is-visible');
              });
            });

            const reposition = () => positionCallout();
            window.addEventListener('resize', reposition);
            window.addEventListener('scroll', reposition);

            function hideCallout() {
              localStorage.setItem(ONBOARDING_KEY, 'true');
              callout.classList.remove('is-visible');
              setupBtn.classList.remove('settings-highlight');
              setTimeout(() => callout.remove(), 300);
              window.removeEventListener('resize', reposition);
              window.removeEventListener('scroll', reposition);
            }

            setupBtn.addEventListener('click', hideCallout);

            // Auto-hide if user clicks elsewhere
            setTimeout(() => {
              document.addEventListener('click', (e) => {
                if (!e.target.closest('#navCopySetupButton')) {
                  hideCallout();
                }
              }, { once: true });
            }, 1000);
          })();

          // Copy API key from nav button
          function copyNavApiKey(btn) {
            if (!btn) return;
            const apiKey = btn.dataset.apiKey || '';
            if (!apiKey) {
              alert('API key unavailable.');
              return;
            }

            const original = btn.innerHTML;
            btn.disabled = true;

            const setCopiedState = () => {
              btn.innerHTML = `
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Copied!
              `;
              btn.classList.add('border-emerald-500/50', 'text-emerald-400');
              setTimeout(() => {
                btn.innerHTML = original;
                btn.classList.remove('border-emerald-500/50', 'text-emerald-400');
                btn.disabled = false;
              }, 1800);
            };

            navigator.clipboard.writeText(apiKey)
              .then(setCopiedState)
              .catch(() => {
                try {
                  const textarea = document.createElement('textarea');
                  textarea.value = apiKey;
                  textarea.style.position = 'fixed';
                  textarea.style.opacity = '0';
                  document.body.appendChild(textarea);
                  textarea.select();
                  document.execCommand('copy');
                  document.body.removeChild(textarea);
                  setCopiedState();
                } catch (err) {
                  console.error('Failed to copy API key:', err);
                  btn.disabled = false;
                  alert('Failed to copy API key. Please copy manually.');
                }
              });
          }
        </script>
        <% } %>

          <main class="<%= user ? 'py-8' : 'py-4' %>">
            <%- body %>
          </main>
          <script src="/js/setup-script.js"></script>
          <script src="/js/notifications.js"></script>
          <script nonce="<%= cspNonce %>">
            (function () {
              function initSharedMobileNavActions() {
                if (document.body.dataset.mobileOverflowDelegated === 'true') return;

                const button = document.getElementById('mobileNavActionsToggle');
                const menu = document.getElementById('mobileNavActionsMenu');
                if (!button || !menu) return;

                const syncAriaState = () => {
                  const isOpen = document.body.classList.contains('mobile-nav-actions-open');
                  button.setAttribute('aria-expanded', String(isOpen));
                  button.setAttribute('aria-label', isOpen ? 'Close navigation actions' : 'Open navigation actions');
                };

                document.body.dataset.mobileOverflowDelegated = 'true';
                syncAriaState();

                document.addEventListener('click', (event) => {
                  const target = event.target;
                  if (!target || typeof target.closest !== 'function') return;

                  const clickedToggle = target.closest('#mobileNavActionsToggle');
                  const clickedNavActions = target.closest('#mobileNavActionsToggle, nav .nav-right-buttons');

                  if (clickedToggle) {
                    event.preventDefault();
                    event.stopPropagation();
                    document.body.classList.toggle('mobile-nav-actions-open');
                    syncAriaState();
                    return;
                  }

                  if (!clickedNavActions && document.body.classList.contains('mobile-nav-actions-open')) {
                    document.body.classList.remove('mobile-nav-actions-open');
                    syncAriaState();
                  }
                });
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initSharedMobileNavActions, { once: true });
              } else {
                initSharedMobileNavActions();
              }
            })();
          </script>

          <!-- Global Feedback Panel -->
          <div id="feedbackPanel" class="feedback-panel hidden">
            <div class="feedback-panel-header">
              <h4 class="feedback-panel-title">Send Feedback</h4>
              <button id="feedbackCloseBtn" type="button" class="feedback-close-btn" aria-label="Close feedback">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <div class="feedback-panel-body">
              <p class="feedback-panel-hint">Your feedback is completely anonymous.</p>
              <textarea id="feedbackTextarea" class="feedback-textarea"
                placeholder="What's on your mind? Bug reports, feature ideas, or just say hi..." rows="4"
                maxlength="5000"></textarea>
              <div class="mt-2 flex items-center gap-2 text-xs text-slate-400">
                <label for="feedbackImageInput" class="cursor-pointer hover:text-slate-200">Attach one image</label>
                <input id="feedbackImageInput" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden">
                <span id="feedbackImageName" aria-live="polite"></span>
                <button id="feedbackImageClear" type="button" class="hidden text-slate-400 hover:text-white" aria-label="Remove feedback image">×</button>
              </div>
              <div class="feedback-char-count">
                <span id="feedbackCharCount">0</span> / 5000
              </div>
            </div>
            <div class="feedback-panel-footer">
              <button id="feedbackLoveBtn" type="button" class="feedback-love-btn" title="Send some love!">
                <svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                  <path
                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                </svg>
              </button>
              <button id="feedbackSendBtn" type="button" class="feedback-send-btn" disabled>
                Send Feedback
              </button>
            </div>

            <!-- Success State -->
            <div id="feedbackSuccess" class="feedback-success hidden">
              <svg class="feedback-success-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="feedback-success-text">Thanks!</span>
            </div>
          </div>
          <!-- Feedback submissions use multipart requests when an image is attached.
               Version this script so clients never keep a pre-upload implementation cached. -->
          <script src="/js/feedback.js?v=<%= Date.now() %>"></script>
</body>

</html>
