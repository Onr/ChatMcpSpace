                          <div class="absolute -translate-x-1/2 -translate-y-1/2 w-9 h-9 rounded-full border border-white/20 shadow-lg <%= isFocused ? 'ring-2 ring-emerald-400/60 scale-110' : '' %>"
                            style="left:<%= x %>%; top:<%= y %>%; background: <%= agentGradient %>;">
                          </div>
                          <% }); %>
                      </div>
                    </div>
                  </div>

                  <div class="flex flex-col bg-slate-900/50 rounded-xl border border-white/5 overflow-hidden">
                    <div class="p-3 border-b border-white/5 flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full border border-white/20 shadow-lg"
                        style="background: <%= (previewFocusedAgent && previewFocusedAgent.avatarGradient) ? previewFocusedAgent.avatarGradient : 'linear-gradient(135deg, #38bdf8, #2563eb)' %>;">
                      </div>
                      <div>
                        <h3 class="text-xs font-semibold text-white"><%= previewFocusedAgent ? previewFocusedAgent.name :
