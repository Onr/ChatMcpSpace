        const previewAgents = Array.isArray(previewModel.agents) ? previewModel.agents : [];
        const previewFocusedAgentId = previewModel.focusedAgentId || (previewAgents[0] ? previewAgents[0].agentId : '');
        const previewFocusedAgent = previewAgents.find((agent) => agent.agentId === previewFocusedAgentId) || previewAgents[0] || null;
        const previewMessagesByAgent = (previewModel.messagesByAgent && typeof previewModel.messagesByAgent === 'object')
          ? previewModel.messagesByAgent
          : {};
        const previewMessagesRaw = previewFocusedAgent ? (previewMessagesByAgent[previewFocusedAgent.agentId] || []) : [];
        const fallbackPreviewMessage = {
          role: 'assistant',
          content: 'Ready to assist. Select an agent from the council to view their messages and interactive content.'
        };
        const previewMessages = previewMessagesRaw.length ? previewMessagesRaw : [fallbackPreviewMessage];
        const previewRenderMode = previewModel.renderMode === 'iframe' ? 'iframe' : 'inline';
        const previewIframeUrl = previewModel.iframeUrl || '/dashboard-preview?embedded=1';
        const previewIframeTitle = previewModel.iframeTitle || 'Live dashboard preview';
