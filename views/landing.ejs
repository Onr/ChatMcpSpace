                        </svg>
                        <span class="text-[8px] font-semibold text-cyan-400 uppercase tracking-wider">Agent Space</span>
                        <span class="text-[8px] text-cyan-400/40 ml-auto">▾</span>
                      </div>
                      <div class="px-3 pb-3">
                        <div class="grid grid-cols-2 gap-1.5">
