  <% const mfaChallengeSafe = typeof mfaChallenge !== 'undefined' ? mfaChallenge : null; %>
  <% if (mfaChallengeSafe) { %>
  <!-- Keep the authentication-code step immediately visible instead of placing it below the landing page. -->
  <div id="mfaChallengeDialog" class="fixed inset-0 z-[100] flex items-center justify-center overflow-y-auto bg-slate-950/85 px-4 py-6 backdrop-blur-sm" style="position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;min-height:100vh;min-height:100dvh;overflow-y:auto;overscroll-behavior:contain;" role="dialog" aria-modal="true" aria-labelledby="mfaDialogTitle">
    <div class="w-full max-w-sm rounded-2xl border border-emerald-400/25 bg-slate-900 p-5 shadow-2xl shadow-black/50 sm:p-6" style="position:relative;width:100%;max-width:24rem;margin:auto;">
      <div class="mb-5 text-center">
        <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-full border border-emerald-400/25 bg-emerald-400/10 text-emerald-300" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v-6a4 4 0 00-8 0v4" /></svg>
        </div>
        <h2 id="mfaDialogTitle" class="text-xl font-semibold text-white">Verify your sign-in</h2>
        <p class="mt-2 text-sm text-slate-300">Enter the current 6-digit code for <span class="font-medium text-white"><%= mfaChallengeSafe.email %></span>, or a saved recovery code.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-center text-sm text-red-200" role="alert"><%= error %></div>
      <% } %>

      <form id="mfaForm" class="space-y-4" action="/login/2fa" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="mfaCode" class="block text-sm font-medium text-slate-200">Authenticator or recovery code</label>
        <input id="mfaCode" name="code" type="text" inputmode="text" autocomplete="one-time-code" pattern="(?:[0-9]{6}|[A-Za-z0-9]{4}(?:-[A-Za-z0-9]{4}){3})" required autofocus
          class="w-full rounded-lg border border-white/15 bg-slate-800 px-4 py-3.5 text-center text-lg tracking-[0.2em] text-white placeholder-slate-500 outline-none transition-colors focus:border-emerald-300 focus:ring-2 focus:ring-emerald-300/20"
          placeholder="123456 or XXXX-XXXX-XXXX-XXXX" maxlength="19" aria-describedby="mfaCodeHelp">
        <p id="mfaCodeHelp" class="text-center text-xs text-slate-400">Use the 6-digit code from your authenticator, or one saved recovery code.</p>
        <button id="mfaSubmit" type="submit" class="w-full rounded-lg border border-white/5 bg-white py-3.5 text-sm font-semibold text-slate-900 shadow-lg transition-colors hover:bg-slate-200">Verify code</button>
        <div class="text-center"><a href="/" class="text-sm text-slate-400 transition-colors hover:text-white">Back to sign in</a></div>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Auth Section: Clean & Simple -->
  <section id="auth-section" class="<%= mfaChallengeSafe ? 'hidden' : '' %> py-8 px-6 border-t border-white/5 bg-slate-900/60 backdrop-blur-md relative z-20">
