                            <div class="text-[7px] text-emerald-300/70 uppercase">Hotfix</div>
                            <div class="text-[11px] font-bold text-emerald-400">Deployed</div>
                          </div>
                          <div class="bg-amber-500/10 border border-amber-500/20 rounded-md p-2">
                            <div class="text-[7px] text-amber-300/70 uppercase">P95 Latency</div>
                            <div class="text-[11px] font-bold text-amber-400">1.2s</div>
