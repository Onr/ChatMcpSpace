                        <span class="text-[9px] text-slate-400">Active now</span>
                      </div>
                    </div>
                    <div class="flex-1 p-4 space-y-3 overflow-hidden">
                      <% previewMessages.slice(-4).forEach((message)=> { const
                        isUserMessage=message.role==='user';
                        // Skip rich_html JSON messages in inline text rendering
                        let isRichJson = false;
                        try { const parsed = JSON.parse(message.content); isRichJson = parsed && parsed.type === 'rich_html'; } catch(e) {}
                        if (isRichJson) return;
                        %>
                        <div class="flex gap-2 <%= isUserMessage ? 'justify-end' : '' %>">
                          <% if (!isUserMessage) { %>
                            <div class="w-5 h-5 rounded-full flex-shrink-0 mt-1"
                              style="background: <%= (previewFocusedAgent && previewFocusedAgent.avatarGradient) ? previewFocusedAgent.avatarGradient : 'linear-gradient(135deg, #38bdf8, #2563eb)' %>;">
                            </div>
