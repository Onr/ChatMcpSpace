                          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 rounded-full border border-emerald-500/30 bg-slate-800 flex items-center justify-center z-10 overflow-hidden shadow-[0_0_15px_rgba(16,185,129,0.2)]">
                          <div class="w-full h-full opacity-80"
